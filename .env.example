# External APIs (fill in only the services you use)
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
AMAP_API_KEY=
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# Optional Langfuse observability
